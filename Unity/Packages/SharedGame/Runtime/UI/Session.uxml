<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <ui:Style src="Session.uss" />
  <ui:VisualElement class="screen" picking-mode="Ignore">
    <ui:Button name="menuToggle" text="Hide menu" class="menu-toggle" />
    <ui:ScrollView class="card">
      <ui:Label text="SHAREDGAME" class="title" />
      <ui:Label name="message" text="Choose a session mode." class="message" />
      <ui:VisualElement name="connection">
        <ui:EnumField name="mode" label="Mode" />
        <ui:IntegerField name="playerCount" label="Players (2–4)" value="2" />
        <ui:Label name="rosterHelp" text="Use the same ordered player roster on every peer." class="message" />
        <ui:VisualElement class="endpoint"><ui:TextField name="address0" label="Player 0 IPv4" value="127.0.0.1" /><ui:IntegerField name="port0" label="UDP port" value="7000" /></ui:VisualElement>
        <ui:VisualElement class="endpoint"><ui:TextField name="address1" label="Player 1 IPv4" value="127.0.0.1" /><ui:IntegerField name="port1" label="UDP port" value="7001" /></ui:VisualElement>
        <ui:VisualElement class="endpoint"><ui:TextField name="address2" label="Player 2 IPv4" value="127.0.0.1" /><ui:IntegerField name="port2" label="UDP port" value="7002" /></ui:VisualElement>
        <ui:VisualElement class="endpoint"><ui:TextField name="address3" label="Player 3 IPv4" value="127.0.0.1" /><ui:IntegerField name="port3" label="UDP port" value="7003" /></ui:VisualElement>
        <ui:IntegerField name="localPlayer" label="Local player index" value="0" />
        <ui:IntegerField name="controller" label="Local controller (0 arrows, 1 WASD)" value="0" />
        <ui:IntegerField name="host" label="Spectator host player" value="0" />
        <ui:IntegerField name="listenPort" label="Spectator listening port" value="7100" />
        <ui:TextField name="spectators" label="Spectator IPv4:port (one per line)" multiline="true" value="" />
        <ui:Label name="networkHelp" text="Use direct, reachable UDP endpoints. Player 0 hosts spectators by default. Register the spectator endpoint on the host before joining." class="message" />
        <ui:Button name="start" text="Start session" />
      </ui:VisualElement>
      <ui:VisualElement name="session" class="hidden">
        <ui:VisualElement class="player"><ui:Label name="status0" /><ui:ProgressBar name="progress0" title="Connection" low-value="0" high-value="100" /><ui:Button name="disconnect0" text="Disconnect" /></ui:VisualElement>
        <ui:VisualElement class="player"><ui:Label name="status1" /><ui:ProgressBar name="progress1" title="Connection" low-value="0" high-value="100" /><ui:Button name="disconnect1" text="Disconnect" /></ui:VisualElement>
        <ui:VisualElement class="player"><ui:Label name="status2" /><ui:ProgressBar name="progress2" title="Connection" low-value="0" high-value="100" /><ui:Button name="disconnect2" text="Disconnect" /></ui:VisualElement>
        <ui:VisualElement class="player"><ui:Label name="status3" /><ui:ProgressBar name="progress3" title="Connection" low-value="0" high-value="100" /><ui:Button name="disconnect3" text="Disconnect" /></ui:VisualElement>
        <ui:Button name="stop" text="Stop session" /><ui:Button name="restart" text="Restart session" />
        <ui:Button name="diagnosticsToggle" text="Toggle diagnostics" />
      </ui:VisualElement>
    </ui:ScrollView>
  </ui:VisualElement>
</ui:UXML>
